/target/
/**/target/
*.rmeta
*.rlib
.idea/
.vscode/
*.swp
*.tmp

# Kernel test/demo artifacts (timestamped logs + summaries from QEMU runs)
artifacts/kernel/*.log
artifacts/kernel/*.summary.txt

# Generated audit chain fixtures (deterministic; regenerated by `audit-replay gen-fixture`).
artifacts/audit/*.json

# Generated zpl-asm output ELFs (regenerated by `scripts/build-examples.ps1`).
artifacts/programs/*.elf

# Reproducible-build per-round hash logs.
artifacts/repro/*.log

# Generated ZPL-FS disk images (regenerated by `scripts/fs-test.ps1`).
artifacts/fs/*.img

# Limine hybrid ISO output + unpacked Limine blobs (scripts/build-iso.ps1)
artifacts/iso/*
!artifacts/iso/.gitkeep

# A superseded single-month planning note, kept out of the tree.
AGENTS_LUNA1.md

# Python bytecode from the helper scripts. Committed once by accident while
# staging a whole directory; it is a build artefact of whatever interpreter ran.
__pycache__/
*.pyc
